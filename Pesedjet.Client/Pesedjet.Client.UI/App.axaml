<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pesedjet.Client.UI.App"
             xmlns:local="using:Pesedjet.Client.UI"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://Pesedjet.Client.UI/Styles/EgyptSandBackground.axaml"/>
        <StyleInclude Source="avares://Pesedjet.Client.UI/Styles/PesedjetTheme.axaml"/>
    </Application.Styles>
</Application>
