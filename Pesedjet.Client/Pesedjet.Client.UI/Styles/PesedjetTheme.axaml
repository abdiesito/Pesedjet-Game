    <!-- Match (GUI-009) -->
    <Style Selector="Border.card-face">
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="220"/>
        <Setter Property="Background" Value="{DynamicResource ColorCardFace}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorSandShadow}"/>
        <Setter Property="BorderThickness" Value="3"/>
