    <Style Selector="Button.radio-card:disabled">
        <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <Style Selector="Button.radio-card TextBlock.radio-title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="Button.radio-card TextBlock.radio-hint">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Button.radio-card.selected TextBlock.radio-title">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnPrimary}"/>
    </Style>
    <Style Selector="Button.radio-card.selected TextBlock.radio-hint">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>
    <Style Selector="Path.radio-dot">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{DynamicResource ColorTextSecondary}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.radio-card.selected Path.radio-dot">
        <Setter Property="Stroke" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="Fill" Value="{DynamicResource ColorAccentLight}"/>
    </Style>
    <Style Selector="Grid.setup-grid">
        <Setter Property="Margin" Value="0,18,0,0"/>
    </Style>
    <Style Selector="StackPanel.setup-column">
        <Setter Property="Spacing" Value="14"/>
    </Style>
    <Style Selector="StackPanel.footer-actions">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style Selector="TextBlock.intro-text">
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
    </Style>
    <Style Selector="TextBlock.panel-subtitle">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>


    <!-- Waiting room (GUI-008) and invite dialog -->
    <Style Selector="Border.code-box">
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    </Style>
    <Style Selector="TextBlock.code-text">
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="6"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorAccentLight}"/>
    </Style>
    <Style Selector="Border.settings-strip">
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Background" Value="{DynamicResource ColorAccentLightTint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorSandShadow}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    </Style>
    <Style Selector="StackPanel.strip-group">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
