    <Style Selector="ItemsControl.pick-list">
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style Selector="Button.pick-row">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurfaceRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.pick-row /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSurfaceRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>
    <Style Selector="Button.pick-row:disabled">
        <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="Button.pick-row.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimary}"/>
    </Style>
    <Style Selector="Button.chip-btn">
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurfaceRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.chip-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSurfaceRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>
    <Style Selector="Button.chip-btn:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="Button.chip-btn.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimary}"/>
    </Style>
    <Style Selector="Border.summary-row">
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    </Style>
    <Style Selector="Border.summary-row.winner">
        <Setter Property="Background" Value="{DynamicResource ColorSandHighlight}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
    </Style>
    <Style Selector="Border.summary-row.out">
        <Setter Property="Opacity" Value="0.7"/>
    </Style>
    <Style Selector="Border.summary-row TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.summary-head">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
    </Style>
    <Style Selector="TextBlock.points-gain">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorSuccess}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector="StackPanel.summary-modal">
        <Setter Property="Spacing" Value="10"/>
    </Style>
    <Style Selector="Border.summary-card">
        <Setter Property="Width" Value="1000"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPopup}"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.summary-card.result">
        <Setter Property="Width" Value="720"/>
    </Style>
    <Style Selector="Border.summary-header">
        <Setter Property="Padding" Value="24,16"/>
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>
    <Style Selector="Border.summary-body">
        <Setter Property="Padding" Value="24,18"/>
    </Style>
    <Style Selector="TextBlock.result-title">
        <Setter Property="FontFamily" Value="{DynamicResource FontTitleDisplay}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.result-subtitle">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.exit-row">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

</Styles>
