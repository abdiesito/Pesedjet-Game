        <StreamGeometry x:Key="IconClose">M 6,6 L 18,18 M 18,6 L 6,18</StreamGeometry>
        <StreamGeometry x:Key="IconDiamond">M 12,3 L 21,12 L 12,21 L 3,12 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSortDown">M 5,8 L 12,17 L 19,8 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSortUp">M 5,16 L 12,7 L 19,16 Z</StreamGeometry>
        <StreamGeometry x:Key="IconMenu">M 4,7 H 20 M 4,12 H 20 M 4,17 H 20</StreamGeometry>
        <StreamGeometry x:Key="IconCrown">M 4,18 H 20 M 5,18 L 4,8 L 9,12 L 12,6 L 15,12 L 20,8 L 19,18</StreamGeometry>
        <StreamGeometry x:Key="IconDoor">M 6,4 H 14 V 20 H 6 Z M 14,6 L 18,8 V 18 L 14,20 M 11,12 V 12.5</StreamGeometry>
        <StreamGeometry x:Key="IconCopy">M 8,8 H 19 V 20 H 8 Z M 5,16 V 4 H 16</StreamGeometry>
        <StreamGeometry x:Key="IconSend">M 3,12 L 21,4 L 15,21 L 11,13 Z M 11,13 L 21,4</StreamGeometry>
        <StreamGeometry x:Key="IconChat">M 4,5 H 20 V 16 H 11 L 6,20 V 16 H 4 Z</StreamGeometry>
