        <Thickness x:Key="MarginCornerTopLeft">32,28,0,0</Thickness>
        <Thickness x:Key="MarginToast">0,28,0,0</Thickness>
        <Thickness x:Key="PaddingProfileChip">6,6,20,6</Thickness>

        <x:Double x:Key="ControlHeight">48</x:Double>
        <x:Double x:Key="ControlHeightPill">46</x:Double>
        <x:Double x:Key="AvatarSize">34</x:Double>
        <x:Double x:Key="BadgeSize">18</x:Double>
        <x:Double x:Key="ProfileNameMaxWidth">260</x:Double>
        <x:Double x:Key="ToastMaxWidth">480</x:Double>
        <x:Double x:Key="SpacingMenu">12</x:Double>
        <x:Double x:Key="ControlHeightPrimary">50</x:Double>
        <x:Double x:Key="ControlHeightCompact">34</x:Double>
        <x:Double x:Key="CheckBoxSize">20</x:Double>
        <x:Double x:Key="SpacingForm">20</x:Double>
        <x:Double x:Key="SpacingField">7</x:Double>
        <x:Double x:Key="SpacingFormCompact">8</x:Double>
        <x:Double x:Key="SpacingFieldCompact">5</x:Double>
        <x:Double x:Key="ControlHeightField">42</x:Double>
        <x:Double x:Key="SpacingBrandList">10</x:Double>

        <x:Double x:Key="CardWidth">900</x:Double>
        <x:Double x:Key="CardFrameHeight">690</x:Double>
        <x:Double x:Key="BrandPanelWidth">340</x:Double>

