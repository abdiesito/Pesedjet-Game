        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>
    <Style Selector="Border.unseen-pip.filled">
        <Setter Property="Background" Value="{DynamicResource ColorAccent}"/>
    </Style>

    <Style Selector="Button.hand-card">
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="220"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="RenderTransform" Value="translateY(0px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.hand-card /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.hand-card:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-14px)"/>
    </Style>
    <Style Selector="Button.hand-card.selected">
        <Setter Property="RenderTransform" Value="translateY(-14px)"/>
    </Style>
    <Style Selector="Button.hand-card.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="4"/>
