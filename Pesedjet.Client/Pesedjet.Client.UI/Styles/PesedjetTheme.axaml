        <SolidColorBrush x:Key="ColorCardFace" Color="#F6E3B4"/>
        <SolidColorBrush x:Key="ColorTimerBar" Color="#E6C280"/>
        <SolidColorBrush x:Key="ColorTimerWarning" Color="#F4B6C2"/>
