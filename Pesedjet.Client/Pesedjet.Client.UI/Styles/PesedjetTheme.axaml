            C 21.5,9.5 21.5,14.5 18.5,17.5</StreamGeometry>
        <StreamGeometry x:Key="IconDisplay">M 4,5 H 20 V 16 H 4 Z M 9,20 H 15 M 12,16 V 20</StreamGeometry>
        <StreamGeometry x:Key="IconLanguage">M 21,12 A 9,9 0 1 1 3,12 A 9,9 0 1 1 21,12 Z M 3,12 H 21 M 12,3 C 15,6 15,18
            12,21 M 12,3 C 9,6 9,18 12,21</StreamGeometry>
        <StreamGeometry x:Key="IconKey">M 14,10 A 4,4 0 1 1 6,10 A 4,4 0 1 1 14,10 Z M 13,13 L 20,20 M 17,17 L 19,15
            </StreamGeometry>

        <x:Double x:Key="ScreenPanelWidth">1100</x:Double>
        <x:Double x:Key="ScreenPanelHeight">680</x:Double>
        <x:Double x:Key="SearchFieldWidth">340</x:Double>
        <x:Double x:Key="PersonAvatarSize">40</x:Double>
        <x:Double x:Key="ModalWidth">520</x:Double>
        <x:Double x:Key="ModalWidthWide">680</x:Double>
        <x:Double x:Key="MenuPanelWidth">320</x:Double>
        <x:Double x:Key="CodeFieldHeight">68</x:Double>
        <FontFamily x:Key="FontMono">Menlo, Consolas, Courier New, monospace</FontFamily>
        <x:Double x:Key="ScoreNameMaxWidth">300</x:Double>
        <x:Double x:Key="NotificationsPanelWidth">400</x:Double>
        <Thickness x:Key="MarginNotificationsPanel">0,82,32,24</Thickness>
        <x:Double x:Key="AvatarChoiceSize">46</x:Double>
        <x:Double x:Key="ControlHeightTextArea">96</x:Double>
        <x:Double x:Key="SettingsWindowWidth">1100</x:Double>
        <x:Double x:Key="SettingsWindowHeight">680</x:Double>
        <x:Double x:Key="SettingsNavWidth">260</x:Double>
        <x:Double x:Key="SettingsFieldMaxWidth">560</x:Double>
        <Thickness x:Key="MarginDialogSafeArea">24</Thickness>
        <Thickness x:Key="PaddingSettingsHeader">20,14</Thickness>
        <Thickness x:Key="PaddingSettingsContent">36,32</Thickness>
    </Styles.Resources>

    <!-- Default font for the whole UI: every control inherits it unless a style sets its own (e.g. FontTitleDisplay).
        Needed because the "TextBlock" selector below does not match derived types such as AccessText. -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
    </Style>

    <!-- Buttons clip to their bounds by default, which cuts the focus ring and leaves its corners square. -->
    <Style Selector="Button">
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
    </Style>

    <Style Selector="Path.icon">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeJoin" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Path.spinner">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Data" Value="{DynamicResource GeometrySpinner}"/>
        <Setter Property="Stroke" Value="{DynamicResource ColorTextOnPrimary}"/>
        <Setter Property="StrokeThickness" Value="3"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Setter Property="RenderTransform">
            <RotateTransform/>
        </Setter>
    </Style>
    <!-- Every animation instance stays subscribed to the global animation clock after its control is gone, and a style
        animation creates its instance as soon as the control exists, even if it is hidden. The spinner lives hidden
        inside every login/register button, so it only gets its animation while the button is .loading (IsBusy). -->
    <Style Selector="Button.loading Path.spinner">
        <Style.Animations>
            <Animation Duration="0:0:0.9" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="StackPanel.inline-icon-text">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="8"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Icons use Stretch=Uniform, which ignores the stroke: half of it lands outside the icon box. Templated
        controls (ContentControl, Button, CheckBox...) clip to their bounds by default and cut that half off
        (flat left/bottom edges). Every component that hosts an icon or a border-sized part opts out here. -->
    <Style Selector="ContentControl.field-message,
                     HeaderedContentControl.alert,
                     Button.alert-action,
                     ToggleButton.reveal-toggle,
                     CheckBox.check-standard,
                     HeaderedContentControl.requirement,
                     ContentControl.brand-note,
                     Button.back-btn,
                     Button.menu-btn,
                     Button.corner-btn,
                     Button.profile-chip">
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>

    <Style Selector="Viewbox.fit-down">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StretchDirection" Value="DownOnly"/>
        <Setter Property="Margin" Value="{DynamicResource MarginScreenSafeArea}"/>
    </Style>

    <Style Selector="Panel.card-frame">
        <Setter Property="Width" Value="{DynamicResource CardWidth}"/>
        <Setter Property="Height" Value="{DynamicResource CardFrameHeight}"/>
    </Style>

    <Style Selector="Border.card">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
        <Setter Property="BoxShadow" Value="0 24 60 0 #593C280A, 0 0 0 6 #59F3DBA2"/>
    </Style>

    <!-- Screens taller than the login card (GUI-013...): 1:1 card anchored under the language selector. It never
        shrinks; when the window is short, the form column scrolls instead (see ScrollViewer.form-scroll). -->
    <Style Selector="Border.card.card-top">
        <Setter Property="Width" Value="{DynamicResource CardWidth}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="{DynamicResource MarginScreenSafeArea}"/>
    </Style>

    <Style Selector="Border.brand-panel">
        <Setter Property="Width" Value="{DynamicResource BrandPanelWidth}"/>
        <Setter Property="Padding" Value="{DynamicResource PaddingBrand}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCardLeft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="0,0,3,0"/>
        <Setter Property="Background">
            <RadialGradientBrush Center="50%,30%" GradientOrigin="50%,30%" RadiusX="90%" RadiusY="90%">
                <GradientStop Offset="0" Color="#0B2A45"/>
                <GradientStop Offset="0.7" Color="#05192B"/>
            </RadialGradientBrush>
        </Setter>
    </Style>

    <Style Selector="StackPanel.brand-stack">
        <Setter Property="Spacing" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.brand-title">
        <Setter Property="FontFamily" Value="{DynamicResource FontTitleDisplay}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="LetterSpacing" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.brand-divider">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="2"/>
        <Setter Property="Background" Value="{DynamicResource ColorAccent}"/>
    </Style>

    <Style Selector="TextBlock.brand-subtitle">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBrandSubtitle}"/>
        <!-- Cairo has no italic design: asking for FontStyle=Italic makes Avalonia build a synthetic typeface on every
            text layout and never release it. A slant transform gives the same look without touching the font. -->
        <Setter Property="RenderTransformOrigin" Value="50%,100%"/>
        <Setter Property="RenderTransform" Value="skew(-10deg, 0deg)"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="StackPanel.brand-stack-top">
        <Setter Property="Spacing" Value="{DynamicResource SpacingForm}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="StackPanel.brand-header">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="12"/>
    </Style>
    <Style Selector="Path.brand-mark">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Stroke" Value="{DynamicResource ColorAccent}"/>
    </Style>
    <Style Selector="TextBlock.brand-title.compact">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.brand-section-title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="1.5"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorAccent}"/>
    </Style>
    <Style Selector="StackPanel.brand-list">
        <Setter Property="Spacing" Value="{DynamicResource SpacingBrandList}"/>
    </Style>
    <Style Selector="Border.brand-rule">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ColorAccentLightTintStrong}"/>
    </Style>

    <Style Selector="HeaderedContentControl.requirement">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Path Name="PART_Icon" Classes="icon"/>
                    <ContentPresenter Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                                      Content="{TemplateBinding Header}"
                                      TextWrapping="Wrap"/>
                    <ContentPresenter Name="PART_Status" Grid.Column="2" IsVisible="False"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="HeaderedContentControl.requirement /template/ Path#PART_Icon">
        <Setter Property="Data" Value="{DynamicResource IconCircle}"/>
        <Setter Property="Stroke" Value="{Binding $parent[HeaderedContentControl].Foreground}"/>
    </Style>
    <Style Selector="HeaderedContentControl.requirement /template/ ContentPresenter#PART_Status">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
    </Style>
    <Style Selector="HeaderedContentControl.requirement.met">
        <Setter Property="Foreground" Value="{DynamicResource ColorOnDarkSuccess}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="HeaderedContentControl.requirement.met /template/ Path#PART_Icon">
        <Setter Property="Data" Value="{DynamicResource IconCheck}"/>
    </Style>
    <Style Selector="HeaderedContentControl.requirement.met /template/ ContentPresenter#PART_Status">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="ContentControl.brand-note">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*">
                    <Path Name="PART_Icon" Classes="icon" Margin="0,2,12,0"/>
                    <ContentPresenter Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      TextWrapping="Wrap"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ContentControl.brand-note /template/ Path#PART_Icon">
        <Setter Property="Stroke" Value="{Binding $parent[ContentControl].Foreground}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="ContentControl.brand-note.info /template/ Path#PART_Icon">
        <Setter Property="Data" Value="{DynamicResource IconInfo}"/>
    </Style>
    <Style Selector="ContentControl.brand-note.age /template/ Path#PART_Icon">
        <Setter Property="Data" Value="{DynamicResource IconUser}"/>
    </Style>

    <Style Selector="ContentControl.pyramid-emblem">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Canvas Width="190" Height="130">
                    <Ellipse Canvas.Left="78" Canvas.Top="5" Width="34" Height="34"
                             Stroke="{DynamicResource ColorAccentLight}" StrokeThickness="2"/>
                    <Path Data="M 15,124 L 95,46 L 175,124 Z"
                          Stroke="{DynamicResource ColorAccent}" StrokeThickness="2.5"
                          Fill="{DynamicResource ColorAccentTint}"/>
                    <Path Data="M 95,46 L 115,124" Opacity="0.7"
                          Stroke="{DynamicResource ColorAccent}" StrokeThickness="1.5"/>
                    <Path Data="M 45,92 H 145 M 30,108 H 160" Opacity="0.45"
                          Stroke="{DynamicResource ColorAccent}" StrokeThickness="1"/>
                </Canvas>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Border.form-panel">
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="Padding" Value="{DynamicResource PaddingForm}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCardRight}"/>
    </Style>

    <Style Selector="StackPanel.form-stack">
        <Setter Property="Spacing" Value="{DynamicResource SpacingForm}"/>
    </Style>

    <!-- Long forms (GUI-013): tighter rhythm so six fields and their messages fit a 1080 window -->
    <Style Selector="StackPanel.form-stack-compact">
        <Setter Property="Spacing" Value="{DynamicResource SpacingFormCompact}"/>
    </Style>
    <Style Selector="StackPanel.form-stack-compact StackPanel.field">
        <Setter Property="Spacing" Value="{DynamicResource SpacingFieldCompact}"/>
    </Style>
    <Style Selector="StackPanel.form-stack-compact TextBox.input-field">
        <Setter Property="Height" Value="{DynamicResource ControlHeightField}"/>
    </Style>

    <!-- The bar lives in a gutter that borrows the panel's right padding, so it never covers the fields -->
    <Style Selector="ScrollViewer.form-scroll">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Padding" Value="0,0,14,0"/>
        <Setter Property="Margin" Value="0,0,-14,0"/>
    </Style>

    <Style Selector="StackPanel.heading-group">
        <Setter Property="Spacing" Value="6"/>
    </Style>

    <Style Selector="StackPanel.field">
        <Setter Property="Spacing" Value="{DynamicResource SpacingField}"/>
    </Style>

    <Style Selector="UniformGrid.button-row">
        <Setter Property="Columns" Value="2"/>
    </Style>
    <Style Selector="UniformGrid.button-row > Button:nth-child(1)">
        <Setter Property="Margin" Value="0,0,7,0"/>
    </Style>
    <Style Selector="UniformGrid.button-row > Button:nth-last-child(1)">
        <Setter Property="Margin" Value="7,0,0,0"/>
    </Style>

    <Style Selector="TextBlock.heading-1">
        <Setter Property="FontFamily" Value="{DynamicResource FontTitleDisplay}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>

    <Style Selector="TextBlock.body-secondary">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="TextBlock.field-hint">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="TextBlock.field-label">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style Selector="TextBlock.field-label.error">
        <Setter Property="Foreground" Value="{DynamicResource ColorError}"/>
    </Style>

    <Style Selector="Run.required">
        <Setter Property="Text" Value=" *"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorError}"/>
    </Style>

    <Style Selector="TextBox.input-field">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderInput}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusInput}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="Padding" Value="10,0,8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.input-field /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextMuted}"/>
    </Style>
    <Style Selector="TextBox.input-field:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderInputHover}"/>
    </Style>
    <Style Selector="TextBox.input-field:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BoxShadow" Value="0 0 0 3 #73C18F3C"/>
    </Style>
    <Style Selector="TextBox.input-field.error /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ColorErrorBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorError}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="TextBox.input-field:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ColorSurfaceDisabled}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderDisabled}"/>
    </Style>

    <Style Selector="TextBox.password">
        <Setter Property="PasswordChar" Value="•"/>
    </Style>

    <Style Selector="Path.field-icon">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="13,0,0,0"/>
        <Setter Property="Stroke" Value="{DynamicResource ColorTextMuted}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
    </Style>

    <Style Selector="ToggleButton.reveal-toggle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Name="PART_Icon" Classes="icon"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"/>
                        <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.reveal-toggle /template/ Path#PART_Icon">
        <Setter Property="Data" Value="{DynamicResource IconEye}"/>
    </Style>
    <Style Selector="ToggleButton.reveal-toggle:checked /template/ Path#PART_Icon">
        <Setter Property="Data" Value="{DynamicResource IconEyeOff}"/>
    </Style>
    <Style Selector="ToggleButton.reveal-toggle:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ColorSecondaryHover}"/>
    </Style>
    <Style Selector="ToggleButton.reveal-toggle:focus-visible /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="0 0 0 3 #C18F3C"/>
    </Style>

    <Style Selector="ContentControl.field-message">
        <Setter Property="Foreground" Value="{DynamicResource ColorError}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*">
                    <Path Name="PART_Icon" Classes="icon" Width="17" Height="17"
                          Margin="0,1,8,0" VerticalAlignment="Top"/>
                    <ContentPresenter Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      TextWrapping="Wrap"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ContentControl.field-message /template/ Path#PART_Icon">
        <Setter Property="Data" Value="{DynamicResource IconAlert}"/>
        <Setter Property="Stroke" Value="{Binding $parent[ContentControl].Foreground}"/>

    </Style>
    <Style Selector="ContentControl.field-message.warning">
        <Setter Property="Foreground" Value="{DynamicResource ColorWarningText}"/>
    </Style>
    <Style Selector="ContentControl.field-message.warning /template/ Path#PART_Icon">
        <Setter Property="Data" Value="{DynamicResource IconWarning}"/>
    </Style>

    <Style Selector="HeaderedContentControl.alert">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="{DynamicResource PaddingAlert}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusInput}"/>
        <Setter Property="BorderThickness" Value="5,1.5,1.5,1.5"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorInfoText}"/>
        <Setter Property="Background" Value="{DynamicResource ColorInfoBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorInfoBorder}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Name="PART_Icon" Classes="icon" Width="20" Height="20"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="2.2"/>
                        <ContentPresenter Grid.Column="1" Margin="10,0"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Header}"
                                          TextWrapping="Wrap"/>
                        <ContentPresenter Grid.Column="2"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="HeaderedContentControl.alert /template/ Path#PART_Icon">
        <Setter Property="Data" Value="{DynamicResource IconInfo}"/>
        <!-- Path.icon's own Stroke wins over a TemplateBinding, so the colour is bound from the style -->
        <Setter Property="Stroke" Value="{Binding $parent[HeaderedContentControl].Foreground}"/>
    </Style>

    <Style Selector="HeaderedContentControl.alert.error">
        <Setter Property="Foreground" Value="{DynamicResource ColorError}"/>
        <Setter Property="Background" Value="{DynamicResource ColorErrorBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorError}"/>
    </Style>
    <Style Selector="HeaderedContentControl.alert.error /template/ Path#PART_Icon">
        <Setter Property="Data" Value="{DynamicResource IconAlert}"/>
    </Style>

    <Style Selector="HeaderedContentControl.alert.warning">
        <Setter Property="Foreground" Value="{DynamicResource ColorWarningText}"/>
        <Setter Property="Background" Value="{DynamicResource ColorWarningBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorWarningBorder}"/>
    </Style>
    <Style Selector="HeaderedContentControl.alert.warning /template/ Path#PART_Icon">
        <Setter Property="Data" Value="{DynamicResource IconWarning}"/>
    </Style>

    <Style Selector="HeaderedContentControl.alert.success">
        <Setter Property="Foreground" Value="{DynamicResource ColorSuccess}"/>
        <Setter Property="Background" Value="{DynamicResource ColorSuccessBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorSuccess}"/>
    </Style>
    <Style Selector="HeaderedContentControl.alert.success /template/ Path#PART_Icon">
        <Setter Property="Data" Value="{DynamicResource IconCheck}"/>
    </Style>

    <Style Selector="Button.alert-action">
        <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorError}"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorError}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.alert-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorErrorBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorError}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorError}"/>
    </Style>
    <Style Selector="Button.alert-action Path.icon">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Stroke" Value="{DynamicResource ColorError}"/>
        <Setter Property="StrokeThickness" Value="2.2"/>
    </Style>

    <Style Selector="Button.primary-btn">
        <Setter Property="Height" Value="{DynamicResource ControlHeightPrimary}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeButton}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.primary-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 4 0 0 #000000"/>
    </Style>
    <Style Selector="Button.primary-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnPrimary}"/>
    </Style>
    <Style Selector="Button.primary-btn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryHover}"/>
        <Setter Property="BoxShadow" Value="0 0 0 3 #FFFFFF, 0 0 0 6 #C18F3C"/>
    </Style>
    <Style Selector="Button.primary-btn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>
    <Style Selector="Button.primary-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryPressed}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnPrimary}"/>
        <Setter Property="BoxShadow" Value="inset 0 3 8 0 #99000000"/>
    </Style>
    <Style Selector="Button.primary-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorBorderDisabled}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextDisabled}"/>
        <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
    </Style>
    <Style Selector="Button.primary-btn.loading:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryLoading}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnPrimary}"/>
    </Style>

    <Style Selector="Button.secondary-btn">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeButtonSecondary}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.secondary-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSecondaryHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="Button.secondary-btn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSecondaryHover}"/>
        <Setter Property="BoxShadow" Value="0 0 0 3 #FFFFFF, 0 0 0 6 #C18F3C"/>
    </Style>
    <Style Selector="Button.secondary-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSecondaryPressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>

    <Style Selector="Button.accent-btn">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ColorSandHighlight}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccentHover}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeButtonSecondary}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.accent-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSand}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccentHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="Button.accent-btn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSand}"/>
        <Setter Property="BoxShadow" Value="0 0 0 3 #FFFFFF, 0 0 0 6 #C18F3C"/>
    </Style>
    <Style Selector="Button.accent-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSandShadow}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccentHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>

    <Style Selector="Button.secondary-btn:disabled, Button.accent-btn:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="Button.secondary-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="Button.accent-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSandHighlight}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccentHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>

    <Style Selector="Button.link-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,2"/>
        <!-- Negative right margin: the text stays flush with the field edge despite the pill padding. -->
        <Setter Property="Margin" Value="0,0,-6,0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.back-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="-6,0,0,0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="TextBlock.back-text">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="Button.link-btn /template/ ContentPresenter#PART_ContentPresenter,
                     Button.link-btn:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     Button.back-btn /template/ ContentPresenter#PART_ContentPresenter,
                     Button.back-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.link-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.back-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorAccentTint}"/>
    </Style>
    <Style Selector="Button.link-btn:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.back-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorAccentTintStrong}"/>
    </Style>
    <Style Selector="Button.link-btn:focus-visible /template/ ContentPresenter#PART_ContentPresenter,
                     Button.back-btn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 0 0 3 #C18F3C"/>
    </Style>
    <Style Selector="Button.link-btn:disabled, Button.back-btn:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="TextBlock.link-text">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="TextDecorations">
            <TextDecorationCollection>
                <TextDecoration Location="Underline"
                                Stroke="#C18F3C"
                                StrokeThickness="2" StrokeThicknessUnit="Pixel"
                                StrokeOffset="4" StrokeOffsetUnit="Pixel"/>
            </TextDecorationCollection>
        </Setter>
    </Style>
    <Style Selector="Button.link-btn:pointerover TextBlock.link-text">
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimaryHover}"/>
    </Style>

    <Style Selector="ContentControl.divider-labeled">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextMuted}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto,*">
                    <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource ColorDivider}"/>
                    <ContentPresenter Grid.Column="1" Margin="14,0" Content="{TemplateBinding Content}"/>
                    <Border Grid.Column="2"
                            Height="1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ColorDivider}"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="CheckBox.check-standard">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <!-- 20x20 = the template's box column; any bigger and the CheckBox (clips to its bounds) cuts the border -->
    <Style Selector="CheckBox.check-standard /template/ Border#NormalRectangle">
        <Setter Property="Width" Value="{DynamicResource CheckBoxSize}"/>
        <Setter Property="Height" Value="{DynamicResource CheckBoxSize}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCheck}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderInput}"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
    </Style>
    <Style Selector="CheckBox.check-standard:pointerover /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
    </Style>
    <Style Selector="CheckBox.check-standard:focus-visible /template/ Border#NormalRectangle">
        <Setter Property="BoxShadow" Value="0 0 0 3 #FFFFFF, 0 0 0 5 #C18F3C"/>
    </Style>
    <Style Selector="CheckBox.check-standard:checked /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
    </Style>
    <Style Selector="CheckBox.check-standard:checked:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryHover}"/>
    </Style>
    <Style Selector="CheckBox.check-standard:checked /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource ColorAccentLight}"/>
    </Style>

    <!-- The tinted pill (hover/pressed) needs inner room;
        the negative margin keeps the box aligned with the fields. -->
    <Style Selector="CheckBox.check-standard">
        <Setter Property="Margin" Value="-6,0,0,0"/>
    </Style>
    <Style Selector="CheckBox.check-standard /template/ Border#PART_Border">
        <Setter Property="Padding" Value="6,0,12,0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
    </Style>
    <!-- Text colour is set for every state: Fluent recolours it on hover/press (white in the system dark theme),
        which made the label vanish on the white card. The part is PART_ContentPresenter, not ContentPresenter. -->
    <Style Selector="CheckBox.check-standard /template/ ContentPresenter#PART_ContentPresenter,
           CheckBox.check-standard:pointerover /template/ ContentPresenter#PART_ContentPresenter,
           CheckBox.check-standard:pressed /template/ ContentPresenter#PART_ContentPresenter,
           CheckBox.check-standard:checked /template/ ContentPresenter#PART_ContentPresenter,
           CheckBox.check-standard:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter,
           CheckBox.check-standard:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="CheckBox.check-standard:pointerover /template/ Border#PART_Border,
           CheckBox.check-standard:checked:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ColorAccentTint}"/>
    </Style>
    <Style Selector="CheckBox.check-standard:pressed /template/ Border#PART_Border,
           CheckBox.check-standard:checked:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource ColorAccentTintStrong}"/>
    </Style>

    <Style Selector="ComboBox.language-selector">
        <Setter Property="Width" Value="270"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="{DynamicResource MarginCornerTopRight}"/>
        <Setter Property="Padding" Value="18,0,12,0"/>
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="ComboBox.language-selector /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BoxShadow" Value="0 4 14 0 #4005192B"/>
    </Style>
    <Style Selector="ComboBox.language-selector:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
    </Style>
    <Style Selector="ComboBox.language-selector:focus-visible /template/ Border#Background">
        <Setter Property="BoxShadow" Value="0 0 0 3 #F3DBA2, 0 0 0 6 #05192B"/>
    </Style>
    <Style Selector="ComboBox.language-selector /template/ ContentControl#ContentPresenter,
                     ComboBox.language-selector:pointerover /template/ ContentControl#ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>
    <Style Selector="ComboBox.language-selector /template/ PathIcon#DropDownGlyph,
                     ComboBox.language-selector:pointerover /template/ PathIcon#DropDownGlyph">
        <Setter Property="Foreground" Value="{DynamicResource ColorAccentLight}"/>
    </Style>
    <Style Selector="ComboBox.language-selector /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPopup}"/>
        <Setter Property="Padding" Value="6"/>
    </Style>
    <Style Selector="ComboBox.language-selector ComboBoxItem">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>
    <Style Selector="ComboBox.language-selector ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorAccentLightTint}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>
    <Style Selector="ComboBox.language-selector ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorAccentLightTintStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>

    <!-- Main menu (GUI-002): the card is centered in the same frame as the login card, so the menu opens in place -->
    <Style Selector="Border.card.card-centered">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="StackPanel.menu-stack">
        <Setter Property="Spacing" Value="{DynamicResource SpacingMenu}"/>
    </Style>

    <Style Selector="Border.menu-divider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Background" Value="{DynamicResource ColorDivider}"/>
    </Style>

    <Style Selector="Button.primary-btn.menu-btn Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource ColorTextOnPrimary}"/>
    </Style>

    <Style Selector="Button.profile-chip">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Margin" Value="{DynamicResource MarginCornerTopLeft}"/>
        <Setter Property="Padding" Value="{DynamicResource PaddingProfileChip}"/>
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.profile-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
    </Style>
    <Style Selector="Button.profile-chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryPressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
    </Style>
    <Style Selector="Button.profile-chip:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryHover}"/>
        <Setter Property="BoxShadow" Value="0 0 0 3 #F3DBA2, 0 0 0 6 #05192B"/>
    </Style>

    <Style Selector="StackPanel.profile-content">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="12"/>
    </Style>

    <Style Selector="Border.avatar">
        <Setter Property="Width" Value="{DynamicResource AvatarSize}"/>
        <Setter Property="Height" Value="{DynamicResource AvatarSize}"/>
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryLoading}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.avatar-initials">
        <Setter Property="FontFamily" Value="{DynamicResource FontTitleDisplay}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.profile-name">
        <Setter Property="MaxWidth" Value="{DynamicResource ProfileNameMaxWidth}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.profile-stats">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>

    <Style Selector="Button.corner-btn">
        <Setter Property="Width" Value="{DynamicResource ControlHeightPill}"/>
        <Setter Property="Height" Value="{DynamicResource ControlHeightPill}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="{DynamicResource MarginCornerTopRight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.corner-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
    </Style>
    <Style Selector="Button.corner-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryPressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
    </Style>
    <Style Selector="Button.corner-btn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryHover}"/>
        <Setter Property="BoxShadow" Value="0 0 0 3 #F3DBA2, 0 0 0 6 #05192B"/>
    </Style>
    <Style Selector="Button.corner-btn Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- The count sits in a bordered circle, so it is told apart by shape and not only by colour -->
    <Style Selector="Border.badge">
        <Setter Property="MinWidth" Value="{DynamicResource BadgeSize}"/>
        <Setter Property="Height" Value="{DynamicResource BadgeSize}"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Margin" Value="0,2,2,0"/>
        <Setter Property="Background" Value="{DynamicResource ColorError}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="TextBlock.badge-text">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="HeaderedContentControl.alert.toast">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="{DynamicResource MarginToast}"/>
        <Setter Property="MaxWidth" Value="{DynamicResource ToastMaxWidth}"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
    </Style>


    <!-- Settings window (GUI-010) -->
    <!-- Dialogs (MOD-xxx) are a layer inside the main window: a scrim over the whole window with the dialog card
        in the middle, so they read as part of the game and not as another operating system window. -->
    <Style Selector="Grid.dialog-scrim">
        <Setter Property="Background" Value="{DynamicResource ColorOverlay}"/>
    </Style>
    <Style Selector="Viewbox.dialog-fit">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StretchDirection" Value="DownOnly"/>
        <Setter Property="Margin" Value="{DynamicResource MarginDialogSafeArea}"/>
    </Style>
    <Style Selector="Border.dialog-card">
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
        <Setter Property="BoxShadow" Value="0 24 60 0 #593C280A, 0 0 0 6 #59F3DBA2"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.settings-card">
        <Setter Property="Width" Value="{DynamicResource SettingsWindowWidth}"/>
        <Setter Property="Height" Value="{DynamicResource SettingsWindowHeight}"/>
    </Style>

    <Style Selector="Border.panel-header">
        <Setter Property="Padding" Value="{DynamicResource PaddingSettingsHeader}"/>
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>
    <Style Selector="StackPanel.panel-header-content">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="18"/>
    </Style>
    <Style Selector="TextBlock.panel-title">
        <Setter Property="FontFamily" Value="{DynamicResource FontTitleDisplay}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.header-btn">
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.header-btn /template/ ContentPresenter#PART_ContentPresenter,
                     Button.header-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>
    <Style Selector="Button.header-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorAccentLightTint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>
    <Style Selector="Button.header-btn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 0 0 3 #F3DBA2"/>
    </Style>
    <Style Selector="Button.header-btn Path.icon">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Stroke" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>

    <Style Selector="Border.settings-nav">
        <Setter Property="Width" Value="{DynamicResource SettingsNavWidth}"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>
    <Style Selector="StackPanel.nav-stack">
        <Setter Property="Spacing" Value="8"/>
    </Style>

    <Style Selector="Button.nav-item">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.nav-item /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.nav-item:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSecondaryHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="Button.nav-item:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 0 0 3 #C18F3C"/>
    </Style>
    <Style Selector="Button.nav-item.selected /template/ ContentPresenter#PART_ContentPresenter,
                     Button.nav-item.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.nav-item.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnPrimary}"/>
    </Style>
    <Style Selector="Button.nav-item.selected Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource ColorTextOnPrimary}"/>
    </Style>

    <Style Selector="ScrollViewer.section-scroll">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Padding" Value="{DynamicResource PaddingSettingsContent}"/>
    </Style>

    <Style Selector="StackPanel.settings-section">
        <Setter Property="Spacing" Value="{DynamicResource SpacingForm}"/>
    </Style>
    <Style Selector="StackPanel.settings-list">
        <Setter Property="Spacing" Value="0"/>
    </Style>
    <Style Selector="StackPanel.setting-label">
        <Setter Property="Spacing" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.settings-fields">
        <Setter Property="Spacing" Value="{DynamicResource SpacingForm}"/>
        <Setter Property="MaxWidth" Value="{DynamicResource SettingsFieldMaxWidth}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style Selector="TextBlock.section-title">
        <Setter Property="FontFamily" Value="{DynamicResource FontTitleDisplay}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>

    <Style Selector="Border.setting-row">
        <Setter Property="Padding" Value="0,14"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="StackPanel.choice-group">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="12"/>
    </Style>
    <Style Selector="TextBlock.setting-value">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.choice-btn">
        <Setter Property="Height" Value="{DynamicResource ControlHeightField}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Padding" Value="18,0"/>
    </Style>
    <Style Selector="Button.secondary-btn.selected /template/ ContentPresenter#PART_ContentPresenter,
                     Button.secondary-btn.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.secondary-btn.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnPrimary}"/>
    </Style>
    <Style Selector="Button.secondary-btn.selected Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource ColorTextOnPrimary}"/>
    </Style>

    <Style Selector="ComboBox.select-field">
        <Setter Property="Height" Value="{DynamicResource ControlHeightField}"/>
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderInput}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusInput}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="ComboBox.select-field /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderInput}"/>
    </Style>
    <Style Selector="ComboBox.select-field:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderInputHover}"/>
    </Style>
    <Style Selector="ComboBox.select-field:focus-visible /template/ Border#Background">
        <Setter Property="BoxShadow" Value="0 0 0 3 #73C18F3C"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimary}"/>
    </Style>
    <Style Selector="ComboBox.select-field /template/ ContentControl#ContentPresenter,
                     ComboBox.select-field:pointerover /template/ ContentControl#ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="ComboBox.select-field /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderInput}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPopup}"/>
    </Style>
    <Style Selector="ComboBox.select-field ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="ComboBox.select-field ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSecondaryHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="ComboBox.select-field ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorAccentTintStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>

    <!-- Fluent reads these keys for the track, thumb and switch colours; they are set to the palette values
        (ColorPrimary #05192B, ColorAccentLight #F5D28E, ColorBorderDisabled #C5CDD6, ColorBorderInput #8796A6). -->
    <Style Selector="Slider.volume-slider">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="SmallChange" Value="5"/>
        <Setter Property="LargeChange" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Resources>
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#05192B"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#05192B"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#05192B"/>
            <SolidColorBrush x:Key="SliderTrackFill" Color="#C5CDD6"/>
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#C5CDD6"/>
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#C5CDD6"/>
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#F5D28E"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#F5D28E"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#C18F3C"/>
        </Style.Resources>
    </Style>
    <Style Selector="Slider.volume-slider.muted">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="ToggleSwitch.switch-standard">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Style.Resources>
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#C5CDD6"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#C5CDD6"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#C5CDD6"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#8796A6"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#8796A6"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#8796A6"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#F1F3F5"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#C5CDD6"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#C5CDD6"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#05192B"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#05192B"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#05192B"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#05192B"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#05192B"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#05192B"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#F5D28E"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#F5D28E"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#F5D28E"/>
        </Style.Resources>
    </Style>

    <Style Selector="Border.saved-notice">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Background" Value="{DynamicResource ColorSuccessBackground}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Border.saved-notice TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorSuccess}"/>
    </Style>
    <Style Selector="Border.saved-notice Path.icon">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Stroke" Value="{DynamicResource ColorSuccess}"/>
    </Style>

    <Style Selector="Border.requirements-box">
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    </Style>

    <Style Selector="Border.danger-zone">
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorError}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    </Style>
    <Style Selector="TextBlock.danger-title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorError}"/>
    </Style>


    <!-- Dark modals (MOD-001, MOD-004...) -->
    <Style Selector="Border.modal-card">
        <Setter Property="Width" Value="{DynamicResource ModalWidth}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="28"/>
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPopup}"/>
        <Setter Property="BoxShadow" Value="0 24 60 0 #99000000"/>
    </Style>
    <Style Selector="StackPanel.modal-stack">
        <Setter Property="Spacing" Value="18"/>
    </Style>
    <Style Selector="StackPanel.modal-header">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="12"/>
    </Style>
    <Style Selector="Border.modal-icon">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.modal-icon Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.modal-title">
        <Setter Property="FontFamily" Value="{DynamicResource FontTitleDisplay}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Border.modal-divider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ColorAccentLightTintStrong}"/>
    </Style>
    <Style Selector="TextBlock.modal-text">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.modal-label">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>
    <Style Selector="TextBlock.modal-counter">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector="TextBlock.modal-counter.limit">
        <Setter Property="Foreground" Value="{DynamicResource ColorErrorOnDark}"/>
    </Style>
    <Style Selector="ContentControl.field-message.on-dark">
        <Setter Property="Foreground" Value="{DynamicResource ColorErrorOnDark}"/>
    </Style>

    <Style Selector="Button.modal-primary, Button.modal-secondary">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeButtonSecondary}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.modal-primary">
        <Setter Property="Background" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
    </Style>
    <Style Selector="Button.modal-primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimary}"/>
    </Style>
    <Style Selector="Button.modal-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorAccentHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccentHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimary}"/>
    </Style>
    <Style Selector="Button.modal-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorAccentPressed}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccentPressed}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimary}"/>
    </Style>
    <Style Selector="Button.modal-primary:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="Button.modal-primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorPrimary}"/>
    </Style>
    <Style Selector="Button.modal-primary.loading:disabled">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.modal-primary Path.spinner">
        <Setter Property="Stroke" Value="{DynamicResource ColorPrimary}"/>
    </Style>
    <Style Selector="Button.modal-secondary:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="Button.modal-secondary">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
    </Style>
    <Style Selector="Button.modal-secondary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>
    <Style Selector="Button.modal-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorAccentLightTint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>
    <Style Selector="Button.modal-secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorAccentLightTintStrong}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>
    <Style Selector="Button.modal-primary:focus-visible /template/ ContentPresenter#PART_ContentPresenter,
                     Button.modal-secondary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 0 0 3 #05192B, 0 0 0 5 #F5D28E"/>
    </Style>
    <Style Selector="Button.modal-secondary Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource ColorTextOnDark}"/>
    </Style>

    <Style Selector="TextBox.modal-input">
        <Setter Property="Height" Value="{DynamicResource ControlHeightField}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnDark}"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.modal-input.multiline">
        <Setter Property="Height" Value="{DynamicResource ControlHeightTextArea}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBox.modal-input /template/ Border#PART_BorderElement,
                     TextBox.modal-input:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ColorSurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
    </Style>
    <Style Selector="TextBox.modal-input:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ColorSurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="TextBox.modal-input.error /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ColorErrorSurfaceOnDark}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorErrorOnDark}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="ListBox.avatar-list">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.avatar-list ListBoxItem">
        <Setter Property="Width" Value="{DynamicResource AvatarChoiceSize}"/>
        <Setter Property="Height" Value="{DynamicResource AvatarChoiceSize}"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBox.avatar-list ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ListBox.avatar-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryLoading}"/>
    </Style>
    <Style Selector="ListBox.avatar-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.avatar-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.avatar-list ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Path.avatar-icon">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Stroke" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.avatar-check">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Background" Value="{DynamicResource ColorAccentLight}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0,0,-4,-4"/>
    </Style>
    <Style Selector="Border.avatar-check Path.icon">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Stroke" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="StrokeThickness" Value="2.4"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>


    <!-- Notifications panel (PAN-001): a popover under the bell; the whole window around it closes it -->
    <Style Selector="Button.scrim-dismiss">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
    </Style>
    <Style Selector="Button.scrim-dismiss /template/ ContentPresenter#PART_ContentPresenter,
                     Button.scrim-dismiss:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.scrim-dismiss:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Border.popover-panel">
        <Setter Property="Width" Value="{DynamicResource NotificationsPanelWidth}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="{DynamicResource MarginNotificationsPanel}"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPopup}"/>
        <Setter Property="BoxShadow" Value="0 16 40 0 #40000000"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.notifications-header">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="TextBlock.notifications-title">
        <Setter Property="FontFamily" Value="{DynamicResource FontTitleDisplay}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.notifications-count">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ScrollViewer.notifications-scroll">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style Selector="TextBlock.notifications-empty">
        <Setter Property="Margin" Value="28"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
    </Style>

    <Style Selector="Border.notification-item">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="Border.notification-item.new">
        <Setter Property="Background" Value="{DynamicResource ColorAccentLightTintStrong}"/>
    </Style>
    <Style Selector="Border.notification-avatar">
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="StackPanel.notification-body">
        <Setter Property="Spacing" Value="4"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
    </Style>
    <Style Selector="TextBlock.notification-name">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.notification-text">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="StackPanel.notification-meta">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="6"/>
    </Style>
    <Style Selector="StackPanel.notification-meta Path.icon">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Stroke" Value="{DynamicResource ColorTextMuted}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
    </Style>
    <Style Selector="TextBlock.notification-time">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextMuted}"/>
    </Style>
    <Style Selector="TextBlock.notification-expired">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorWarningText}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="StackPanel.notification-actions">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="8"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style Selector="Button.compact">
        <Setter Property="Height" Value="{DynamicResource ControlHeightCompact}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
    </Style>
    <Style Selector="Button.primary-btn.compact /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
    </Style>
    <Style Selector="Button.compact StackPanel.inline-icon-text">
        <Setter Property="Spacing" Value="6"/>
    </Style>
    <Style Selector="Button.compact Path.spinner">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="StrokeThickness" Value="2"/>
    </Style>


    <!-- Friends screens (GUI-003, GUI-004, GUI-005): common panel of the secondary screens -->
    <Style Selector="Border.screen-panel">
        <Setter Property="Width" Value="{DynamicResource ScreenPanelWidth}"/>
        <Setter Property="Height" Value="{DynamicResource ScreenPanelHeight}"/>
    </Style>
    <Style Selector="Border.panel-body">
        <Setter Property="Padding" Value="28,22"/>
    </Style>

    <Style Selector="Border.tab-strip">
        <Setter Property="Padding" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurfaceDisabled}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    </Style>
    <Style Selector="StackPanel.tab-list">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="4"/>
    </Style>
    <Style Selector="Button.tab-btn">
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusInput}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.tab-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="Button.tab-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.tab-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSecondaryHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="Button.tab-btn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 0 0 3 #C18F3C"/>
    </Style>
    <Style Selector="Button.tab-btn.selected /template/ ContentPresenter#PART_ContentPresenter,
                     Button.tab-btn.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.tab-btn.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnPrimary}"/>
    </Style>
    <Style Selector="StackPanel.tab-content">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="4"/>
    </Style>

    <Style Selector="TextBlock.list-summary">
        <Setter Property="Margin" Value="0,16,0,10"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
    </Style>
    <Style Selector="Border.list-frame">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Grid.list-area">
        <Setter Property="Margin" Value="0,16,0,0"/>
    </Style>

    <Style Selector="Border.person-row">
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="Border.person-row:pointerover,
                     Border.person-row:focus-within">
        <Setter Property="Background" Value="{DynamicResource ColorAccentTint}"/>
    </Style>
    <Style Selector="Border.person-avatar">
        <Setter Property="Width" Value="{DynamicResource PersonAvatarSize}"/>
        <Setter Property="Height" Value="{DynamicResource PersonAvatarSize}"/>
    </Style>
    <Style Selector="StackPanel.person-info">
        <Setter Property="Margin" Value="14,0"/>
        <Setter Property="Spacing" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.person-name">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="StackPanel.person-status">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="7"/>
    </Style>
    <Style Selector="TextBlock.person-status-text">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
    </Style>
    <Style Selector="StackPanel.person-actions">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Ellipse.presence">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Ellipse.presence.online">
        <Setter Property="Fill" Value="{DynamicResource ColorSuccess}"/>
    </Style>
    <Style Selector="Ellipse.presence.offline">
        <Setter Property="Stroke" Value="{DynamicResource ColorTextMuted}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
    </Style>
    <Style Selector="Path.presence-diamond">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="{DynamicResource ColorAccent}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.danger-outline">
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorDanger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDanger}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>
    <Style Selector="Button.danger-outline /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDanger}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorDanger}"/>
    </Style>
    <Style Selector="Button.danger-outline:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.danger-outline:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorErrorBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDangerHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorDangerHover}"/>
    </Style>
    <Style Selector="Button.danger-outline:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
