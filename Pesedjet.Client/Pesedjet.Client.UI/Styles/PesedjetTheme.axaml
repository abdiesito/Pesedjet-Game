            M 19,12 H 9</StreamGeometry>
        <StreamGeometry x:Key="IconBell">M 6,17 V 11 A 6,6 0 0 1 18,11 V 17 L 20,19 H 4 Z M 10,21.5 H 14</StreamGeometry>
