<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>

        <FontFamily x:Key="FontTitleDisplay">avares://Pesedjet.Client.UI/Assets/Fonts/AlfaSlabOne-Regular.ttf#Alfa Slab One</FontFamily>
        <FontFamily x:Key="FontBody">avares://Pesedjet.Client.UI/Assets/Fonts#Cairo</FontFamily>

        <x:Double x:Key="FontSizeDisplay">50</x:Double>
        <x:Double x:Key="FontSizeTitle">32</x:Double>
        <x:Double x:Key="FontSizeBrandSubtitle">17</x:Double>
        <x:Double x:Key="FontSizeInput">16</x:Double>
        <x:Double x:Key="FontSizeButton">16</x:Double>
        <x:Double x:Key="FontSizeButtonSecondary">15</x:Double>
        <x:Double x:Key="FontSizeBody">14</x:Double>
        <x:Double x:Key="FontSizeSmall">13</x:Double>

        <SolidColorBrush x:Key="ColorPrimary" Color="#05192B"/>
