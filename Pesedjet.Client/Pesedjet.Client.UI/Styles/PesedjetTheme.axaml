    </Style>
    <Style Selector="Border.visibility-toggle">
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    </Style>
    <Style Selector="Button.segment-btn">
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.segment-btn /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="Button.segment-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorSecondaryHover}"/>
    </Style>
    <Style Selector="Button.segment-btn.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextOnPrimary}"/>
    </Style>
    <Style Selector="Button.segment-btn:disabled">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <Style Selector="TextBlock.section-heading">
        <Setter Property="FontFamily" Value="{DynamicResource FontTitleDisplay}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="Border.room-row">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurfaceCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    </Style>
    <Style Selector="Border.room-row.own">
        <Setter Property="Background" Value="{DynamicResource ColorSandHighlight}"/>
    </Style>
    <Style Selector="Border.room-row.empty">
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorderInput}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.tag">
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ColorPrimary}"/>
    </Style>
    <Style Selector="Border.tag.light">
        <Setter Property="Background" Value="{DynamicResource ColorSecondaryHover}"/>
    </Style>
    <Style Selector="TextBlock.tag-text">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorAccentLight}"/>
    </Style>
    <Style Selector="Border.tag.light TextBlock.tag-text">
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.empty-slot-text">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextMuted}"/>
    </Style>

    <Style Selector="Border.chat-box">
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    <Style Selector="TextBlock.chat-system">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextMuted}"/>
        <Setter Property="RenderTransformOrigin" Value="0%,100%"/>
        <Setter Property="RenderTransform" Value="skew(-8deg, 0deg)"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.chat-author">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.chat-author.own">
        <Setter Property="Foreground" Value="{DynamicResource ColorAccentHover}"/>
    </Style>
    <Style Selector="TextBlock.chat-text">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
    </Style>
    <Style Selector="StackPanel.chat-line">
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="StackPanel.chat-line Path.icon">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="Stroke" Value="{DynamicResource ColorTextMuted}"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
    </Style>
    <Style Selector="Grid.footer-bar">
        <Setter Property="Margin" Value="0,14,0,0"/>
    </Style>
    <Style Selector="TextBlock.footer-note">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
