        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.bar-timer.warning">
        <Setter Property="Foreground" Value="{DynamicResource ColorTimerWarning}"/>
    </Style>
    <Style Selector="ProgressBar.timer-bar">
        <Setter Property="Width" Value="110"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTimerBar}"/>
        <Setter Property="Background" Value="{DynamicResource ColorPrimaryLoading}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ProgressBar.timer-bar.warning">
        <Setter Property="Foreground" Value="{DynamicResource ColorTimerWarning}"/>
    </Style>
    <Style Selector="Border.bar-divider">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="{DynamicResource ColorAccentLightTintStrong}"/>
    </Style>

    <Style Selector="Border.match-panel">
        <Setter Property="Padding" Value="18,14"/>
        <Setter Property="Background" Value="{DynamicResource ColorSurface}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPopup}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorSandShadow}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.match-panel.table">
        <Setter Property="Background" Value="{DynamicResource ColorAccentTint}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style Selector="Border.opponent">
        <Setter Property="Width" Value="270"/>
        <Setter Property="Margin" Value="10,0"/>
        <Setter Property="Padding" Value="14,10"/>
