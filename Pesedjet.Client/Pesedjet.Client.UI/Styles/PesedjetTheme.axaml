    <Style Selector="Path.field-spinner">
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Data" Value="{DynamicResource GeometrySpinner}"/>
        <Setter Property="Stroke" Value="{DynamicResource ColorPrimary}"/>
        <Setter Property="StrokeThickness" Value="2.5"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Setter Property="RenderTransform">
            <RotateTransform/>
        </Setter>
    </Style>
    <Style Selector="Path.field-spinner:not(:disabled)">
        <Style.Animations>
            <Animation Duration="0:0:0.9" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

