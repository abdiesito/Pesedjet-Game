<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <Color x:Key="EgyptSandBaseColor">#E6C280</Color>
        <Color x:Key="EgyptSandShadowColor">#C9A054</Color>
        <Color x:Key="EgyptSandHighlightColor">#F3DBA2</Color>
        <Color x:Key="WindWindLineColor">#40FFFFFF</Color>

        <LinearGradientBrush x:Key="EgyptSandBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0.0" Color="{StaticResource EgyptSandHighlightColor}" />
            <GradientStop Offset="0.4" Color="{StaticResource EgyptSandBaseColor}" />
            <GradientStop Offset="0.8" Color="{StaticResource EgyptSandShadowColor}" />
            <GradientStop Offset="1.0" Color="#A87E3B" />
        </LinearGradientBrush>
    </Styles.Resources>
    
    <Style Selector="Path.Wind1">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform"><TranslateTransform X="0" Y="0"/></Setter>
        <Style.Animations>
            <Animation Duration="0:0:4" IterationCount="Infinite" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="-150"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="150"/><Setter Property="Opacity" Value="0"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Path.Wind2">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform"><TranslateTransform X="0" Y="0"/></Setter>
        <Style.Animations>
            <Animation Duration="0:0:4" Delay="0:0:1.5" IterationCount="Infinite" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="-150"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="150"/><Setter Property="Opacity" Value="0"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    
    <Style Selector="Ellipse.SandParticle">
        <Setter Property="Fill" Value="#60FFFFFF"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform"><TranslateTransform X="0" Y="0"/></Setter>
    </Style>
    
    <Style Selector="Ellipse.Particle1">
        <Style.Animations>
            <Animation Duration="0:0:3" Delay="0:0:0.5" IterationCount="Infinite" Easing="LinearEasing">
                <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0"/><Setter Property="TranslateTransform.Y" Value="0"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.8"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="80"/><Setter Property="TranslateTransform.Y" Value="-60"/><Setter Property="Opacity" Value="0"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Ellipse.Particle2">
        <Style.Animations>
            <Animation Duration="0:0:3" Delay="0:0:1.5" IterationCount="Infinite" Easing="LinearEasing">
                <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0"/><Setter Property="TranslateTransform.Y" Value="0"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.8"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="80"/><Setter Property="TranslateTransform.Y" Value="-60"/><Setter Property="Opacity" Value="0"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Ellipse.Particle3">
        <Style.Animations>
            <Animation Duration="0:0:3" Delay="0:0:2.5" IterationCount="Infinite" Easing="LinearEasing">
                <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0"/><Setter Property="TranslateTransform.Y" Value="0"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.8"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="80"/><Setter Property="TranslateTransform.Y" Value="-60"/><Setter Property="Opacity" Value="0"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="ContentControl.EgyptSandBackground">
        <Setter Property="Background" Value="{StaticResource EgyptSandBackgroundBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <Viewbox Stretch="Fill" Opacity="0.65">
                        <Canvas Width="800" Height="600">
                            
                            <Path Data="M 0,200 C 300,100 500,350 800,250 L 800,600 L 0,600 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Offset="0" Color="#20FFFFFF"/>
                                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            
                            <Path Data="M 0,350 C 250,450 550,200 800,400 L 800,600 L 0,600 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Offset="0" Color="#15000000"/>
                                        <GradientStop Offset="1" Color="#00000000"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            
                            <Path Classes="Wind1" Data="M 50,100 Q 250,50 450,120 T 750,80" 
                                  Stroke="{StaticResource WindWindLineColor}" StrokeThickness="3" StrokeJoin="Round"/>
                            <Path Classes="Wind2" Data="M 0,280 Q 350,220 500,310 T 800,260" 
                                  Stroke="{StaticResource WindWindLineColor}" StrokeThickness="1.5" StrokeJoin="Round"/>
                            
                            <Ellipse Classes="SandParticle Particle1" Width="4" Height="4" Canvas.Left="150" Canvas.Top="450" />
                            <Ellipse Classes="SandParticle Particle2" Width="2" Height="2" Canvas.Left="300" Canvas.Top="500" />
                            <Ellipse Classes="SandParticle Particle3" Width="3" Height="3" Canvas.Left="450" Canvas.Top="350" />
                            <Ellipse Classes="SandParticle Particle1" Width="5" Height="5" Canvas.Left="600" Canvas.Top="480" />
                            <Ellipse Classes="SandParticle Particle2" Width="2" Height="2" Canvas.Left="100" Canvas.Top="250" />
                        </Canvas>
                    </Viewbox>
                    
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>