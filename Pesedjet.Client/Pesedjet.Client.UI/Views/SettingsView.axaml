<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Pesedjet.Client.UI.Utilities.Localization"
             xmlns:vm="using:Pesedjet.Client.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="Pesedjet.Client.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="True">

    <ThemeVariantScope RequestedThemeVariant="Light">
        <Grid Classes="dialog-scrim">
            <Viewbox Classes="dialog-fit">
                <Border Classes="dialog-card settings-card">
                    <Grid RowDefinitions="Auto,*">

                        <Border Classes="panel-header">
                            <StackPanel Classes="panel-header-content">
                                <Button Classes="header-btn" Command="{Binding CloseCommand}">
                                    <StackPanel Classes="inline-icon-text">
                                        <Path Classes="icon" Data="{DynamicResource IconBack}"/>
                                        <TextBlock Text="{Binding [Settings.Back],
                                                                  Source={x:Static
                                                                      loc:LocalizationManager.Instance}}"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Classes="panel-title"
                                           Text="{Binding [Settings.Title],
                                                          Source={x:Static loc:LocalizationManager.Instance}}"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                            <Border Classes="settings-nav">
                                <StackPanel Classes="nav-stack">
                                <Button Classes="nav-item"
                                        Classes.selected="{Binding IsAudioSelected}"
                                        Command="{Binding ShowAudioCommand}">
                                    <StackPanel Classes="inline-icon-text">
                                        <Path Classes="icon" Data="{DynamicResource IconAudio}"/>
                                        <TextBlock Text="{Binding [Settings.Audio],
                                                                  Source={x:Static
                                                                      loc:LocalizationManager.Instance}}"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="nav-item"
                                        Classes.selected="{Binding IsDisplaySelected}"
                                        Command="{Binding ShowDisplayCommand}">
                                    <StackPanel Classes="inline-icon-text">
                                        <Path Classes="icon" Data="{DynamicResource IconDisplay}"/>
                                        <TextBlock Text="{Binding [Settings.Display],
                                                                  Source={x:Static
                                                                      loc:LocalizationManager.Instance}}"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="nav-item"
                                        Classes.selected="{Binding IsLanguageSelected}"
                                        Command="{Binding ShowLanguageCommand}">
                                    <StackPanel Classes="inline-icon-text">
                                        <Path Classes="icon" Data="{DynamicResource IconLanguage}"/>
                                        <TextBlock Text="{Binding [Settings.Language],
                                                                  Source={x:Static
                                                                      loc:LocalizationManager.Instance}}"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="nav-item"
                                        Classes.selected="{Binding IsAccountSelected}"
                                    IsVisible="{Binding IsAccountAvailable}"
                                        Command="{Binding ShowAccountCommand}">
                                    <StackPanel Classes="inline-icon-text">
                                        <Path Classes="icon" Data="{DynamicResource IconKey}"/>
                                        <TextBlock Text="{Binding [Settings.Account],
                                                                  Source={x:Static
                                                                      loc:LocalizationManager.Instance}}"/>
                                    </StackPanel>
                                </Button>
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Column="1" Classes="section-scroll">
                                <ContentControl Content="{Binding CurrentSectionViewModel}"/>
                            </ScrollViewer>
                        </Grid>

                    </Grid>
                </Border>
            </Viewbox>
        </Grid>
    </ThemeVariantScope>
</UserControl>
