<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="using:Pesedjet.Client.UI.Utilities.Behaviors"
             xmlns:loc="using:Pesedjet.Client.UI.Utilities.Localization"
             xmlns:models="using:Pesedjet.Client.UI.Models"
             xmlns:vm="using:Pesedjet.Client.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="Pesedjet.Client.UI.Views.AreYouThereView"
             x:DataType="vm:AreYouThereViewModel"
             x:CompileBindings="True">

    <ThemeVariantScope RequestedThemeVariant="Dark">
        <Grid Classes="dialog-scrim">
            <Viewbox Classes="dialog-fit">
                <Border Classes="modal-card">
                    <StackPanel Classes="modal-stack">
                        <StackPanel Classes="modal-header">
                            <Border Classes="modal-icon">
                                <Path Classes="icon" Data="{DynamicResource IconAlert}"/>
                            </Border>
                            <TextBlock Classes="modal-title"
                                       Text="{Binding [AreYouThere.Title],
                                                      Source={x:Static
                                                          loc:LocalizationManager.Instance}}"/>
                        </StackPanel>
                        <Border Classes="modal-divider"/>
                        <TextBlock Classes="modal-text"
                                   Text="{Binding [AreYouThere.Reason],
                                                  Source={x:Static
                                                      loc:LocalizationManager.Instance}}"/>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Classes="result-title"
                                       FontFamily="{DynamicResource FontMono}"
                                       Foreground="{DynamicResource ColorTimerBar}"
                                       Classes.warning="{Binding IsWarning}"
                                       Text="{Binding RemainingText}"/>
                            <TextBlock Classes="result-subtitle"
                                       Text="{Binding [AreYouThere.ToAnswer],
                                                      Source={x:Static
                                                          loc:LocalizationManager.Instance}}"/>
                        </StackPanel>
                        <TextBlock Classes="modal-text"
                                   Text="{Binding [AreYouThere.Consequence],
                                                  Source={x:Static
                                                      loc:LocalizationManager.Instance}}"/>
                        <Button Classes="modal-primary"
                                behaviors:InitialFocus.IsEnabled="True"
                                Command="{Binding StillHereCommand}"
                                Content="{Binding [AreYouThere.Confirm],
                                    Source={x:Static
                                        loc:LocalizationManager.Instance}}"/>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>
    </ThemeVariantScope>
</UserControl>
