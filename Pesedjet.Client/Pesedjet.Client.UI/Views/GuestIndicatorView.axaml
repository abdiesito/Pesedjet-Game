<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Pesedjet.Client.UI.Utilities.Localization"
             xmlns:vm="using:Pesedjet.Client.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="80"
             x:Class="Pesedjet.Client.UI.Views.GuestIndicatorView"
             x:DataType="vm:TopBarViewModel"
             x:CompileBindings="True">

    <Border Classes="guest-indicator">
        <StackPanel Classes="guest-content">
            <Path Classes="icon" Data="{DynamicResource IconUser}"/>
            <TextBlock Classes="guest-text" Text="{Binding GuestIndicatorText}"/>
            <Button Classes="guest-info-btn" Command="{Binding OpenGuestInformationCommand}">
                <TextBlock Text="{Binding [Guest.WhatIsThis],
                                          Source={x:Static loc:LocalizationManager.Instance}}"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
