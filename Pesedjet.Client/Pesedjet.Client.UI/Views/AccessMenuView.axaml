<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Pesedjet.Client.UI.Utilities.Localization"
             xmlns:vm="using:Pesedjet.Client.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="Pesedjet.Client.UI.Views.AccessMenuView"
             x:DataType="vm:AccessMenuViewModel"
             x:CompileBindings="True">

    <Grid>

        <Viewbox Classes="fit-down">
            <Panel Classes="card-frame">
                <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="brand-panel">
                            <StackPanel Classes="brand-stack">
                                <ContentControl Classes="pyramid-emblem"/>
                                <TextBlock Classes="brand-title"
                                           Text="{Binding [Menu.Title], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                <Border Classes="brand-divider"/>
                                <TextBlock Classes="brand-subtitle"
                                           Text="{Binding [Menu.Subtitle], Source={x:Static loc:LocalizationManager.Instance}}"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Column="1" Classes="form-panel">
                            <StackPanel Classes="form-stack" IsEnabled="{Binding !IsBusy}">

                                <StackPanel Classes="heading-group">
                                    <TextBlock Classes="heading-1"
                                               Text="{Binding [AccessMenu.WelcomeMessage], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                    <TextBlock Classes="body-secondary"
                                               Text="{Binding [AccessMenu.Subtitle], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                </StackPanel>
                                
                                <StackPanel Classes="field">
                                    <TextBlock Classes="field-label" Classes.error="{Binding HasUsernameError}">
                                        <Run Text="{Binding [AccessMenu.Username], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                        <Run Classes="required"/>
                                    </TextBlock>
                                    <TextBox Classes="input-field"
                                             Classes.error="{Binding HasUsernameError}"
                                             Text="{Binding Username}"
                                             MaxLength="50"
                                             Watermark="{Binding [AccessMenu.UsernamePlaceholder], Source={x:Static loc:LocalizationManager.Instance}}">
                                        <TextBox.InnerLeftContent>
                                            <Path Classes="icon field-icon" Data="{DynamicResource IconUser}"/>
                                        </TextBox.InnerLeftContent>
                                    </TextBox>
                                    <ContentControl Classes="field-message"
                                                    Content="{Binding [AccessMenu.ObligatoryField], Source={x:Static loc:LocalizationManager.Instance}}"
                                                    IsVisible="{Binding IsUsernameRequired}"/>
                                    <ContentControl Classes="field-message"
                                                    Content="{Binding [MSG-REG-010], Source={x:Static loc:LocalizationManager.Instance}}"
                                                    IsVisible="{Binding IsUsernameFormatInvalid}"/>
                                </StackPanel>
                                
                                <StackPanel Classes="field">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="field-label" Classes.error="{Binding HasPasswordError}">
                                            <Run Text="{Binding [AccessMenu.Password], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                            <Run Classes="required"/>
                                        </TextBlock>
                                        <Button Grid.Column="1" Classes="link-btn"
                                                Command="{Binding NavigateToForgotPasswordCommand}">
                                            <TextBlock Classes="link-text"
                                                       Text="{Binding [AccessMenu.ForgottenPassword], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                        </Button>
                                    </Grid>
                                    <TextBox Classes="input-field password"
                                             Classes.error="{Binding HasPasswordError}"
                                             Text="{Binding Password}"
                                             RevealPassword="{Binding IsPasswordVisible}">
                                        <TextBox.InnerLeftContent>
                                            <Path Classes="icon field-icon" Data="{DynamicResource IconLock}"/>
                                        </TextBox.InnerLeftContent>
                                        <TextBox.InnerRightContent>
                                            <ToggleButton Classes="reveal-toggle" IsChecked="{Binding IsPasswordVisible}">
                                                <Panel>
                                                    <TextBlock IsVisible="{Binding !IsPasswordVisible}"
                                                               Text="{Binding [AccessMenu.ShowPassword], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                                    <TextBlock IsVisible="{Binding IsPasswordVisible}"
                                                               Text="{Binding [AccessMenu.HidePassword], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                                </Panel>
                                            </ToggleButton>
                                        </TextBox.InnerRightContent>
                                    </TextBox>
                                    <ContentControl Classes="field-message"
                                                    Content="{Binding [AccessMenu.ObligatoryField], Source={x:Static loc:LocalizationManager.Instance}}"
                                                    IsVisible="{Binding IsPasswordRequired}"/>
                                </StackPanel>

                                <CheckBox Classes="check-standard"
                                          IsChecked="{Binding RememberSession}"
                                          Content="{Binding [AccessMenu.RememberSession], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                
                                <HeaderedContentControl Classes="alert error"
                                                        Header="{Binding [AccessMenu.IncorrectCredentials], Source={x:Static loc:LocalizationManager.Instance}}"
                                                        IsVisible="{Binding IsInvalidCredentials}"/>
                                <HeaderedContentControl Classes="alert warning"
                                                        Header="{Binding [AccessMenu.TooManyAttempts], Source={x:Static loc:LocalizationManager.Instance}}"
                                                        IsVisible="{Binding IsTooManyAttempts}"/>
                                <HeaderedContentControl Classes="alert error"
                                                        Header="{Binding [AccessMenu.CouldntReachServer], Source={x:Static loc:LocalizationManager.Instance}}"
                                                        IsVisible="{Binding IsServerUnreachable}">
                                    <Button Classes="alert-action"
                                            Command="{Binding LoginCommand}">
                                        <StackPanel Classes="inline-icon-text">
                                            <Path Classes="icon" Data="{DynamicResource IconRefresh}"/>
                                            <TextBlock Text="{Binding [Common.Retry], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                        </StackPanel>
                                    </Button>
                                </HeaderedContentControl>

                                <Button Classes="primary-btn"
                                        Classes.loading="{Binding IsBusy}"
                                        IsDefault="True"
                                        Command="{Binding LoginCommand}">
                                    <StackPanel Classes="inline-icon-text">
                                        <Path Classes="spinner" IsVisible="{Binding IsBusy}"/>
                                        <TextBlock IsVisible="{Binding !IsBusy}"
                                                   Text="{Binding [AccessMenu.LogIn], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                        <TextBlock IsVisible="{Binding IsBusy}"
                                                   Text="{Binding [AccessMenu.Verifying], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                    </StackPanel>
                                </Button>

                                <ContentControl Classes="divider-labeled"
                                                Content="{Binding [AccessMenu.Or], Source={x:Static loc:LocalizationManager.Instance}}"/>

                                <UniformGrid Classes="button-row">
                                    <Button Classes="secondary-btn"
                                            Command="{Binding NavigateToRegisterAccountCommand}"
                                            Content="{Binding [AccessMenu.CreateAccount], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                    <Button Classes="accent-btn"
                                            Command="{Binding PlayAsGuestCommand}"
                                            Content="{Binding [AccessMenu.PlayAsGuest], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                </UniformGrid>

                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Panel>
        </Viewbox>

    </Grid>
</UserControl>