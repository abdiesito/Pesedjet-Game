<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="using:Pesedjet.Client.UI.Utilities.Behaviors"
             xmlns:loc="using:Pesedjet.Client.UI.Utilities.Localization"
             xmlns:vm="using:Pesedjet.Client.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="Pesedjet.Client.UI.Views.GuestExitView"
             x:DataType="vm:GuestExitViewModel"
             x:CompileBindings="True">

    <ThemeVariantScope RequestedThemeVariant="Dark">
        <Grid Classes="dialog-scrim">
            <Viewbox Classes="dialog-fit">
                <Border Classes="modal-card wide">
                    <StackPanel Classes="modal-stack">
                        <StackPanel Classes="modal-header">
                            <Border Classes="modal-icon">
                                <Path Classes="icon" Data="{DynamicResource IconWarning}"/>
                            </Border>
                            <TextBlock Classes="modal-title"
                                       Text="{Binding [GuestExit.Title],
                                               Source={x:Static
                                                   loc:LocalizationManager.Instance}}"/>
                        </StackPanel>
                        <Border Classes="modal-divider"/>
                        <TextBlock Classes="modal-text"
                                   Text="{Binding [GuestExit.Message],
                                           Source={x:Static
                                               loc:LocalizationManager.Instance}}"/>
                        <TextBlock Classes="modal-label"
                                   TextWrapping="Wrap"
                                   Text="{Binding AliasNotice}"/>
                        <UniformGrid Classes="button-row" Columns="3">
                            <Button Classes="modal-secondary"
                                    behaviors:InitialFocus.IsEnabled="True"
                                    Command="{Binding StayCommand}"
                                    Content="{Binding [GuestExit.Stay],
                                                       Source={x:Static
                                                           loc:LocalizationManager.Instance}}"/>
                            <Button Classes="modal-secondary" Command="{Binding SignUpCommand}">
                                <StackPanel Classes="inline-icon-text">
                                    <Path Classes="icon" Data="{DynamicResource IconUser}"/>
                                    <TextBlock
                                               Text="{Binding [GuestExit.SignUp],
                                                       Source={x:Static
                                                           loc:LocalizationManager.Instance}}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="modal-primary" Command="{Binding LeaveCommand}">
                                <StackPanel Classes="inline-icon-text">
                                    <Path Classes="icon" Data="{DynamicResource IconLogout}"/>
                                    <TextBlock
                                               Text="{Binding [GuestExit.Leave],
                                                       Source={x:Static
                                                           loc:LocalizationManager.Instance}}"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>
    </ThemeVariantScope>
</UserControl>
