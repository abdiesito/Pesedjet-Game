<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="using:Pesedjet.Client.UI.Views.Components"
             xmlns:loc="using:Pesedjet.Client.UI.Utilities.Localization"
             xmlns:vm="using:Pesedjet.Client.UI.ViewModels"
             xmlns:dto="using:Pesedjet.Server.Contracts.DTOs"
             xmlns:conv="using:Pesedjet.Client.UI.Converters"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="Pesedjet.Client.UI.Views.MatchLobbyView"
             x:DataType="vm:MatchLobbyViewModel"
             x:CompileBindings="True">

    <Grid>

        <Border Classes="card card-top">
            <Grid ColumnDefinitions="Auto,*">
                
                <Border Classes="brand-panel">
                    <StackPanel Classes="brand-stack-top">
                        
                        <StackPanel Classes="brand-header">
                            <Path Classes="icon brand-mark" Data="{DynamicResource IconPyramid}"/>
                            <TextBlock Classes="brand-title compact"
                                       Text="{Binding [Menu.Title],
                                                      Source={x:Static loc:LocalizationManager.Instance}}"/>
                        </StackPanel>

                        <StackPanel Classes="brand-list">
                            <TextBlock Classes="brand-section-title"
                                       Text="{Binding [Lobby.RoomCode],
                                                      Source={x:Static loc:LocalizationManager.Instance}}"/>
                            
                            <Border Classes="room-code-card">
                                <TextBlock Classes="room-code-text"
                                           Text="{Binding RoomCode}"/>
                            </Border>

                            <TextBlock Classes="brand-section-title"
                                       Text="{Binding OccupancyText}"/>

                            <TextBlock Classes="body-secondary"
                                       Text="{Binding StatusText}"/>
                        </StackPanel>

                        <Border Classes="brand-rule"/>

                        <ContentControl Classes="brand-note info"
                                        Content="{Binding [Lobby.WaitingForHost],
                                                          Source={x:Static loc:LocalizationManager.Instance}}"
                                        IsVisible="{Binding IsWaitingForHost}"/>
                        
                        <ContentControl Classes="brand-note warning"
                                        Content="{Binding [Messages.MSG-ROOM-005],
                                                          Source={x:Static loc:LocalizationManager.Instance}}"
                                        IsVisible="{Binding ShowMinimumPlayersHint}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="form-panel">
                    <ScrollViewer Classes="form-scroll">
                        <StackPanel Classes="form-stack form-stack-compact" IsEnabled="{Binding !IsBusy}">

                            <Button Classes="back-btn" Command="{Binding LeaveLobbyCommand}">
                                <StackPanel Classes="inline-icon-text">
                                    <Path Classes="icon" Data="{DynamicResource IconBack}"/>
                                    <TextBlock Classes="back-text"
                                               Text="{Binding [Lobby.LeaveRoom],
                                                              Source={x:Static loc:LocalizationManager.Instance}}"/>
                                </StackPanel>
                            </Button>

                            <StackPanel Classes="heading-group">
                                <TextBlock Classes="heading-1"
                                           Text="{Binding [Lobby.Title],
                                                          Source={x:Static loc:LocalizationManager.Instance}}"/>
                                <TextBlock Classes="body-secondary"
                                           Text="{Binding [Lobby.Participants],
                                                          Source={x:Static loc:LocalizationManager.Instance}}"/>
                            </StackPanel>

                            <ItemsControl Classes="members-list" ItemsSource="{Binding Participants}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="dto:RoomMember">
                                        <Border Classes="member-row">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                <TextBlock Classes="member-name"
                                                           Text="{Binding Username}"/>

                                                <StackPanel Grid.Column="1" Classes="badge host">
                                                    <StackPanel.IsVisible>
                                                        <MultiBinding Converter="{x:Static conv:GuidEqualityConverter.Instance}">
                                                            <Binding Path="PlayerId"/>
                                                            <Binding Path="((vm:MatchLobbyViewModel)DataContext).HostPlayerId"
                                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                        </MultiBinding>
                                                    </StackPanel.IsVisible>
                                                    <Path Classes="icon badge-icon" Data="{DynamicResource IconCrown}"/>
                                                    <TextBlock Text="{Binding [Lobby.Host],
                                                                              Source={x:Static loc:LocalizationManager.Instance}}"/>
                                                </StackPanel>

                                                <!-- BADGE LOCAL / TU -->
                                                <TextBlock Grid.Column="2" Classes="badge self">
                                                    <TextBlock.IsVisible>
                                                        <MultiBinding Converter="{x:Static conv:GuidEqualityConverter.Instance}">
                                                            <Binding Path="PlayerId"/>
                                                            <Binding Path="((vm:MatchLobbyViewModel)DataContext).LocalPlayerId"
                                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                        </MultiBinding>
                                                    </TextBlock.IsVisible>
                                                    <TextBlock.Text>
                                                        <Binding Path="[Lobby.You]"
                                                                 Source="{x:Static loc:LocalizationManager.Instance}"/>
                                                    </TextBlock.Text>
                                                </TextBlock>

                                                <!-- BADGE INVITADO -->
                                                <TextBlock Grid.Column="3"
                                                           Classes="badge guest"
                                                           IsVisible="{Binding IsGuest}"
                                                           Text="{Binding [Lobby.Guest],
                                                                          Source={x:Static loc:LocalizationManager.Instance}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <HeaderedContentControl Classes="alert error"
                                                    Header="{Binding ErrorMessage}"
                                                    IsVisible="{Binding HasConnectionError}"/>

                            <UniformGrid Classes="button-row">
                                <Button Classes="secondary-btn"
                                        Command="{Binding LeaveLobbyCommand}"
                                        Content="{Binding [Lobby.LeaveRoom],
                                                          Source={x:Static loc:LocalizationManager.Instance}}"/>
                                
                                <Button Classes="primary-btn"
                                        Classes.loading="{Binding IsBusy}"
                                        IsVisible="{Binding IsHost}"
                                        IsEnabled="{Binding CanStartMatch}"
                                        Command="{Binding StartMatchCommand}">
                                    <StackPanel Classes="inline-icon-text">
                                        <Path Classes="spinner" IsVisible="{Binding IsBusy}"/>
                                        <TextBlock IsVisible="{Binding !IsBusy}"
                                                   Text="{Binding [Lobby.StartMatch],
                                                                  Source={x:Static loc:LocalizationManager.Instance}}"/>
                                        <TextBlock IsVisible="{Binding IsBusy}"
                                                   Text="{Binding [RegisterAccount.Processing],
                                                                  Source={x:Static loc:LocalizationManager.Instance}}"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
        
        <components:LanguageSelector/>

    </Grid>
</UserControl>