<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:Pesedjet.Client.UI.Utilities.Localization"
             xmlns:modelsLobbies="using:Pesedjet.Client.UI.Models.Lobbies"
             xmlns:vm="using:Pesedjet.Client.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="480"
             x:Class="Pesedjet.Client.UI.Views.PublicLobbyListView"
             x:DataType="vm:PublicLobbyListViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto,Auto,*">

        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Classes="choice-header">
                <Border Classes="card-icon">
                    <Path Classes="icon" Data="{DynamicResource IconFriends}"/>
                </Border>
                <TextBlock Classes="card-title"
                           Text="{Binding [PublicLobbies.Title],
                                          Source={x:Static
                                              loc:LocalizationManager.Instance}}"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="secondary-btn compact"
                    Command="{Binding RefreshCommand}">
                <StackPanel Classes="inline-icon-text">
                    <Path Classes="icon" Data="{DynamicResource IconRefresh}"/>
                    <TextBlock
                               Text="{Binding [PublicLobbies.Refresh],
                                              Source={x:Static
                                                  loc:LocalizationManager.Instance}}"/>
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Classes="body-secondary"
                   Grid.Row="1" Margin="0,14,0,14"
                   Text="{Binding [PublicLobbies.Subtitle],
                                  Source={x:Static
                                      loc:LocalizationManager.Instance}}"/>

        <Grid Grid.Row="2">

            <Border Classes="list-frame" IsVisible="{Binding ShowsList}">
                <ScrollViewer Classes="notifications-scroll">
                    <ItemsControl ItemsSource="{Binding Lobbies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="modelsLobbies:PublicLobbyItem">
                                <Border Classes="person-row">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Classes="avatar person-avatar">
                                            <TextBlock Classes="avatar-initials" Text="{Binding Initials}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Classes="person-info">
                                            <TextBlock Classes="person-name"
                                                       Text="{Binding HostUsername}"
                                                       ToolTip.Tip="{Binding HostUsername}"/>
                                            <StackPanel Classes="person-status">
                                                <TextBlock Classes="public-lobby-code" Text="{Binding Code}"/>
                                                <TextBlock Classes="person-status-text"
                                                           Text="{Binding OccupancyText}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="primary-btn compact"
                                                Classes.loading="{Binding IsJoining}"
                                                Command="{Binding JoinCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Classes="inline-icon-text">
                                                <Path Classes="spinner" IsVisible="{Binding IsJoining}"/>
                                                <TextBlock Text="{Binding JoinLabel}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Classes="empty-state" IsVisible="{Binding ShowsEmptyState}">
                <TextBlock Classes="empty-title"
                           Text="{Binding [PublicLobbies.EmptyTitle],
                                          Source={x:Static
                                              loc:LocalizationManager.Instance}}"/>
                <TextBlock Classes="empty-hint"
                           Text="{Binding [PublicLobbies.EmptyHint],
                                          Source={x:Static
                                              loc:LocalizationManager.Instance}}"/>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsLoading}">
                <Border Classes="skeleton-row"/>
                <Border Classes="skeleton-row"/>
                <Border Classes="skeleton-row"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Top" Spacing="8">
                <HeaderedContentControl Classes="alert error"
                                        IsVisible="{Binding HasLoadError}"
                                        Header="{Binding [PublicLobbies.LoadError],
                                                         Source={x:Static
                                                             loc:LocalizationManager.Instance}}">
                    <Button Classes="alert-action" Command="{Binding RefreshCommand}">
                        <StackPanel Classes="inline-icon-text">
                            <Path Classes="icon" Data="{DynamicResource IconRefresh}"/>
                            <TextBlock
                                       Text="{Binding [Common.Retry],
                                                      Source={x:Static
                                                          loc:LocalizationManager.Instance}}"/>
                        </StackPanel>
                    </Button>
                </HeaderedContentControl>
                <ContentControl Classes="field-message"
                                IsVisible="{Binding HasJoinError}"
                                Content="{Binding JoinErrorText}"/>
                <HeaderedContentControl Classes="alert error"
                                        IsVisible="{Binding HasConnectionError}"
                                        Header="{Binding [Common.ConnectionError],
                                                         Source={x:Static
                                                             loc:LocalizationManager.Instance}}"/>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>
